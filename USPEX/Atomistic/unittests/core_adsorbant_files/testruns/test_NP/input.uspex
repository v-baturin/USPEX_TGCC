{
optimizer : {type : GlobalOptimizer
             target: {type: Atomistic
                      compositionSpace: {symbols: [phenyl C6H4CF3] blocks: [[2 2]]}
                      cellUtility: {dim : 0}
                      environmentUtility: {environments: [np_core]}}
             optType: enthalpy
             selection: {type: USPEXClassic
                         popSize: 30
                         optType: (aging enthalpy)
                         fractions: {coreAdsorbantRandomGenerator: (1.0 1.0 1.0)
                                     }
                         }
             }
stages : [mopac1]
numParallelCalcs : 10
numGenerations : 30
stopCrit: 6
}

#define mopac1
{type : mopac, commandExecutable : "MOPAC2016.exe calc.mop"}

#define phenyl
{
 type: adsorbant
 filename: "./phenyl.xyz"
 mountPoint: (1.05521938 -0.14293822  1.86909848)
 orientation: (0.49042023 -0.06649766 0.86894537)
 junctionTypes: ("VERTEX")
 }
 
#define C6H4CF3
{
 type: adsorbant
 filename: "trifluormethyl_benzyl.xyz"
 mountPoint: (-4.51383755 0.40850455 -0.25461973)
 orientation: (-0.94975994 -0.29774402 -0.09646017)
 junctionTypes: ("FACE")
 }
 
#define np_core
{
    type: nanoparticle_core
    filename: "./Au-51-15.xyz"
}
 
