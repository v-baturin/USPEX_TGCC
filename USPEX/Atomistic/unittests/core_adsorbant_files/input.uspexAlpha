{
optimizer : {type : GlobalOptimizer
             target: {type: Atomistic
                      compositionSpace: {symbols: [benzene] blocks: [[2]]}
                      environmentUtility: {environments: [np_core]}}
             optType: enthalpy
             selection: {type: USPEXClassic
                         popSize: 20
                         optType: (aging enthalpy)
                         fractions: {CoreAdsorbantRandomGenerator: (1.0 1.0 1.0)
                                     }
                         }
             }
stages : [mopac1]
numParallelCalcs : 20
numGenerations : 30
stopCrit: 6
}

#define mopac1
{type : mopac, commandExecutable : "MOPAC2016.exe calc.mop"}

#define benzene
{
 type: adsorbant
 filename: "./benzene.xyz"
 mountpoint: (1.2194 -0.1652 2.16)
 orientation: (-0.49042023 0.06649766 -0.86894537)
 connectors: ("VERTEX", "EDGE")
 }
 
#define np_core
{
    type: nanoparticle_core
    file: "./Au-51-15.xyz"
}
 
