&GLOBAL
  PROJECT USPEX
  RUN_TYPE CELL_OPT
  PRINT_LEVEL LOW
&END GLOBAL

&MOTION
  &PRINT
    &RESTART OFF
    &END
    &RESTART_HISTORY OFF
    &END
  &END PRINT
  &CELL_OPT
    TYPE GEO_OPT
    MAX_DR   3.0E-002
    RMS_DR  1.5E-002
    MAX_FORCE  4.5E-003
    RMS_FORCE  3.0E-003
    PRESSURE_TOLERANCE 1000.0
  &END CELL_OPT
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_DR   3.0E-002
    RMS_DR  1.5E-002
    MAX_FORCE  4.5E-003
    RMS_FORCE  3.0E-003
  &END GEO_OPT
&END MOTION

&FORCE_EVAL

  STRESS_TENSOR ANALYTICAL

  METHOD QS
  
  &DFT
    BASIS_SET_FILE_NAME /home/user/cp2k/data/BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME /home/user/cp2k/data/POTENTIAL_UZH
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &MGRID
      NGRIDS 5
      CUTOFF 150
      REL_CUTOFF 30
    &END MGRID
    &SCF
      &PRINT
        &RESTART OFF
        &END RESTART
        &RESTART_HISTORY OFF
        &END RESTART_HISTORY
      &END PRINT
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-04
      MAX_SCF 300
      ADDED_MOS 100
      &DIAGONALIZATION T
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING T
        ALPHA 0.2
        METHOD BROYDEN_MIXING
		NPULAY 7
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 900.0
      &END SMEAR
    &END SCF   
    &XC
      &XC_FUNCTIONAL LDA 
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      @INCLUDE 'kpoints.uspex'
    &END KPOINTS
  &END DFT

  &SUBSYS
    &CELL
        @INCLUDE 'cell.uspex'
    &END
    &COORD
        @INCLUDE 'geometry.uspex'
    &END
    &KIND Li
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND P
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q5
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS

&END FORCE_EVAL
