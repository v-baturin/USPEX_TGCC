# Eu2H18 pbe-Full-Relax

ecut          32
tolvrs        1.0d-10 eV
tolsym        1.0d-5      # same as in VASP

# save disk space
prtwf  0
prtden 0

# optimization parameters
optcell       1           # only-volume optimization
chkprim       0           # allow non-primitive cells
ionmov        2           # BSGF
#dtion         0.1         # ionic relaxation step with FIRE
chkdilatmx    0
#dilatmx       1.2
tolmxf        5.0d-3
ntime         100

# PAW
#pawecutdg    50
#pawovlp      15
               
# SCF procedure  
iscf         17
nstep       100
occopt        6
tsmear        0.01
ecutsm        0.5

